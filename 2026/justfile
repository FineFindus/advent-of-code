AOC_SESSION := `cat ../.adventofcode.session`
DATA_DIRECTORY := "src/data"
YEAR := "2025"

# Show available commands
default:
    just --list

# Download the input for the day
download DAY:
    curl "https://adventofcode.com/{{ YEAR }}/day/$(printf "%d" {{ DAY }})/input" -H "Cookie: session={{ AOC_SESSION }}" -o "{{ DATA_DIRECTORY }}/inputs/{{ DAY }}.txt"

# Setup the files for the day
scaffold DAY: (download DAY)
    touch {{ DATA_DIRECTORY }}/examples/{{ DAY }}.txt
    sed 's/DAY/{{ DAY }}/g' src/template.rs > src/bin/{{ DAY }}.rs
