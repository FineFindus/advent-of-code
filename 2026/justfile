AOC_SESSION := `cat ../.adventofcode.session`
DATA_DIRECTORY := "src/data"
YEAR := "2025"

# Show available commands
default:
    just --list

# Download the input for the day
download DAY:
    curl "https://adventofcode.com/{{ YEAR }}/day/{{ DAY }}/input" -H "Cookie: session={{ AOC_SESSION }}" -o "{{ DATA_DIRECTORY }}/inputs/$(printf "%02d" {{ DAY }}).txt"

# Setup the files for the day
scaffold DAY: (download DAY)
    touch {{ DATA_DIRECTORY }}/examples/$(printf "%02d" {{ DAY }}).txt
    sed 's/DAY/$(printf "%02d" {{ DAY }})/g' src/template.rs > src/bin/$(printf "%02d" {{ DAY }}).rs
